@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка 500";
}
<div class="gp-empty-state">
    <i class="bi bi-bug"></i>
    <h1>Грешка 500 – нещо се обърка</h1>
    <p class="text-muted">Възникна неочаквана грешка при обработката на заявката. Опитайте отново след малко.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Идентификатор на заявката: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-gp" asp-area="" asp-controller="Home" asp-action="Index">Към началната страница</a>
</div>
