@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    string NavClass(string controller, string area = "") =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase)
        && string.Equals(area, currentArea, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";

    bool isSignedIn = User.Identity?.IsAuthenticated == true;
    bool isAdmin = isSignedIn && User.IsInRole(RoleNames.Administrator);
    string admin = RoleNames.AdminArea;
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @ApplicationConstants.ApplicationName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gp-navbar">
            <div class="container">
                <a class="navbar-brand gp-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="gp-brand-mark"><i class="bi bi-shield-shaded"></i></span>
                    <span class="gp-brand-text">Гард<span>Пост</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto gap-lg-1">
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Dashboard", admin)" asp-area="@admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Табло</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Sites", admin)" asp-area="@admin" asp-controller="Sites" asp-action="Index"><i class="bi bi-building"></i> Обекти</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Guards", admin)" asp-area="@admin" asp-controller="Guards" asp-action="Index"><i class="bi bi-person-badge"></i> Охранители</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Shifts", admin)" asp-area="@admin" asp-controller="Shifts" asp-action="Index"><i class="bi bi-calendar-week"></i> График</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Incidents", admin)" asp-area="@admin" asp-controller="Incidents" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Инциденти</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("LeaveRequests", admin)" asp-area="@admin" asp-controller="LeaveRequests" asp-action="Index"><i class="bi bi-airplane"></i> Отпуски</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Users", admin)" asp-area="@admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Потребители</a>
                            </li>
                        }
                        else if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("MySchedule")" asp-area="" asp-controller="MySchedule" asp-action="Index"><i class="bi bi-person-workspace"></i> Начало</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="MySchedule" asp-action="Week"><i class="bi bi-calendar-week"></i> Моят график</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Incidents")" asp-area="" asp-controller="Incidents" asp-action="Index"><i class="bi bi-megaphone"></i> Моите сигнали</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("LeaveRequests")" asp-area="" asp-controller="LeaveRequests" asp-action="Index"><i class="bi bi-airplane"></i> Отпуски</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Начало</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Account")" asp-area="" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i> Регистрация</a>
                            </li>
                        }
                        @if (isSignedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity!.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li><span class="dropdown-item-text small text-muted">@(isAdmin ? RoleNames.AdministratorDisplayName : RoleNames.UserDisplayName)</span></li>
                                    @if (isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="MySchedule" asp-action="Index">Моята страница</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Изход</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4" role="main">
        <partial name="_StatusMessagePartial" />
        @RenderBody()
    </main>

    <footer class="gp-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year @ApplicationConstants.ApplicationName – лесно управление на охраната</span>
            <span>
                <a asp-area="" asp-controller="Home" asp-action="About">За проекта</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isSignedIn)
    {
        @* Anti-forgery token for AJAX requests and the real-time notifications (SignalR). *@
        <form id="gp-antiforgery" class="d-none">@Html.AntiForgeryToken()</form>
        <div class="toast-container position-fixed bottom-0 end-0 p-3" id="gp-toasts" aria-live="polite"></div>
        <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
