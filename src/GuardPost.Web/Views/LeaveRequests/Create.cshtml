@model LeaveRequestFormViewModel
@{
    ViewData["Title"] = "Заявка за отпуск";
    ViewData["Subtitle"] = "Заявката се разглежда от администратор. Одобреният отпуск блокира смените в периода.";
}
<partial name="_PageHeaderPartial" model='"Заявка за отпуск"' />

<div class="gp-card gp-form-card">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<LeaveType>()" class="form-select"></select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Reason" class="form-label"></label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>
        </div>
        <p class="small text-muted mt-3 mb-0">
            <i class="bi bi-info-circle"></i>
            До @EntityValidationConstants.LeaveRequest.MaxDays дни наведнъж, до @EntityValidationConstants.LeaveRequest.MaxMonthsAhead месеца напред.
        </p>
        <div class="gp-form-actions">
            <button type="submit" class="btn btn-gp"><i class="bi bi-send"></i> Изпрати заявката</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
