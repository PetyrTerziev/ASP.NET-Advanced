@model LeaveRequestIndexViewModel
@{
    ViewData["Title"] = "Отпуски";
    var pager = new PagerViewModel
    {
        CurrentPage = Model.Result.Page,
        TotalPages = Model.Result.TotalPages,
        RouteValues = new Dictionary<string, string?>
        {
            ["status"] = Model.Status?.ToString(),
            ["guardId"] = Model.GuardId?.ToString(),
        },
    };
}

<div class="gp-page-header">
    <h1>Заявки за отпуск</h1>
    <p class="text-muted mb-0">Намерени: @Model.Result.TotalCount · чакат решение: @Model.PendingCount</p>
</div>

<form method="get" asp-action="Index" class="gp-filters row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label for="guardId" class="form-label">Охранител</label>
        <select id="guardId" name="guardId" class="form-select">
            <option value="">Всички охранители</option>
            @foreach (var guard in Model.Guards)
            {
                <option value="@guard.Id" selected="@(guard.Id == Model.GuardId)">@guard.Text</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <label for="status" class="form-label">Статус</label>
        <select id="status" name="status" class="form-select">
            <option value="">Всички</option>
            @foreach (LeaveStatus status in Enum.GetValues<LeaveStatus>())
            {
                <option value="@status" selected="@(status == Model.Status)">@status.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-dark"><i class="bi bi-funnel"></i> Филтрирай</button>
    </div>
</form>

<div class="gp-card">
    <partial name="_LeaveTablePartial" model="Model.Result.Items"
             view-data='new ViewDataDictionary(ViewData) { ["ShowGuard"] = true, ["ShowReview"] = true, ["EmptyText"] = "Няма заявки, отговарящи на филтъра." }' />
</div>
<partial name="_PaginationPartial" model="pager" />
